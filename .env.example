# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Django secret key — generate a strong random value for production
SECRET_KEY=your-secret-key-here

# Set to True in local development only
DEBUG=False

# Comma-separated list of allowed hostnames (e.g. yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# NewsAPI key for external news aggregation (https://newsapi.org — free tier available)
# Leave blank to disable external news fetching (GET /api/news/ returns internal only)
NEWS_API_KEY=your_newsapi_key_here
